{
  "manifestVersion": 1,
  "id": "recut.modal-studio",
  "name": "Modal 云函数",
  "author": "Recut",
  "description": "把开源 GPU 项目托管到 modal.com：选择预设包，配置 modal token 后即可部署镜像、准备权重并调用云端函数。",
  "localized": {
    "en": {
      "name": "Modal Functions",
      "description": "Host open-source GPU projects on modal.com: pick a preset pack, configure a modal token, then deploy the image, prepare weights and call cloud functions."
    }
  },
  "repository": "https://github.com/6174/recut-modal-studio",
  "version": "0.1.0",
  "type": "standalone",
  "background": "background.js",
  "ui": {
    "standaloneView": "ui/dist/index.html"
  },
  "permissions": [
    "sqlite",
    "files",
    "media.read",
    "media.write",
    "python",
    "shell"
  ],
  "runtime": {
    "python": {
      "venv": "modal-studio",
      "version": "3.11",
      "requirements": "python/requirements.lock",
      "bootstrap": "bootstrap.py"
    }
  },
  "contributes": {
    "media": {
      "providers": [
        {
          "id": "modal-cloud",
          "name": "Modal 云函数（云端 GPU）",
          "localized": {
            "en": {
              "name": "Modal Functions (cloud GPU)"
            }
          },
          "protocol": "local",
          "operations": {
            "generate": "modal.generate",
            "save": "modal.save",
            "catalog": "modal.catalog",
            "status": "modal.status",
            "task": "modal.task.get"
          },
          "executor": {
            "resultIdPath": "generation.id",
            "inputMap": {
              "model": "model.apiModelId",
              "prompt": "job.prompt",
              "referenceAssetIds": "job.referenceIds",
              "params": "job.output"
            }
          },
          "models": [
            {
              "id": "minimax-h3",
              "name": "MiniMax-H3 视频+音频（文/首尾帧/参考）",
              "capability": "video.generate",
              "runtime": "modal",
              "sizeGb": 270,
              "inputModes": [
                "text",
                "image",
                "video",
                "audio"
              ],
              "parameters": [
                {
                  "name": "prompt",
                  "type": "string"
                },
                {
                  "name": "resolution",
                  "type": "string",
                  "enum": [
                    "768",
                    "576",
                    "480"
                  ],
                  "default": "768"
                },
                {
                  "name": "durationSec",
                  "type": "number",
                  "default": 5,
                  "min": 4,
                  "max": 15
                },
                {
                  "name": "steps",
                  "type": "number",
                  "default": 50,
                  "min": 10,
                  "max": 80
                },
                {
                  "name": "seed",
                  "type": "number",
                  "default": -1
                }
              ],
              "referenceFields": [
                {
                  "field": "referenceImages",
                  "role": "image",
                  "multiple": true
                },
                {
                  "field": "referenceVideos",
                  "role": "video",
                  "multiple": true
                },
                {
                  "field": "referenceAudios",
                  "role": "audio",
                  "multiple": true
                }
              ],
              "weights": {
                "huggingFace": "MiniMaxAI/MiniMax-H3",
                "modelScope": "",
                "revision": "main"
              },
              "referenceBudgets": [
                {
                  "maxImages": 9,
                  "maxVideos": 3,
                  "maxAudios": 3
                }
              ],
              "localized": {
                "zh": {
                  "name": "MiniMax-H3 视频+音频（文/首尾帧/参考）"
                },
                "en": {
                  "name": "MiniMax-H3 video+audio (text/frames/reference)"
                }
              }
            },
            {
              "id": "minimax-h3-one",
              "name": "MiniMax-H3 单卡（文/首尾帧/参考，GPU 快照）",
              "capability": "video.generate",
              "runtime": "modal",
              "sizeGb": 270,
              "inputModes": [
                "text",
                "image",
                "video",
                "audio"
              ],
              "parameters": [
                {
                  "name": "prompt",
                  "type": "string"
                },
                {
                  "name": "resolution",
                  "type": "string",
                  "enum": [
                    "768",
                    "576",
                    "480"
                  ],
                  "default": "768"
                },
                {
                  "name": "durationSec",
                  "type": "number",
                  "default": 5,
                  "min": 4,
                  "max": 15
                },
                {
                  "name": "steps",
                  "type": "number",
                  "default": 50,
                  "min": 10,
                  "max": 80
                },
                {
                  "name": "seed",
                  "type": "number",
                  "default": -1
                }
              ],
              "referenceFields": [
                {
                  "field": "referenceImages",
                  "role": "image",
                  "multiple": true
                },
                {
                  "field": "referenceVideos",
                  "role": "video",
                  "multiple": true
                },
                {
                  "field": "referenceAudios",
                  "role": "audio",
                  "multiple": true
                }
              ],
              "weights": {
                "huggingFace": "MiniMaxAI/MiniMax-H3",
                "modelScope": "",
                "revision": "main"
              },
              "referenceBudgets": [
                {
                  "maxImages": 9,
                  "maxVideos": 3,
                  "maxAudios": 3
                }
              ],
              "localized": {
                "zh": {
                  "name": "MiniMax-H3 单卡（文/首尾帧/参考，GPU 快照）"
                },
                "en": {
                  "name": "MiniMax-H3 single-GPU (text/frames/reference)"
                }
              }
            },
            {
              "id": "minimax-h3-turbo",
              "name": "MiniMax-H3 极速版（Turbo 文/首尾帧 + 参考）",
              "capability": "video.generate",
              "runtime": "modal",
              "sizeGb": 270,
              "inputModes": [
                "text",
                "image",
                "video",
                "audio"
              ],
              "parameters": [
                {
                  "name": "prompt",
                  "type": "string"
                },
                {
                  "name": "resolution",
                  "type": "string",
                  "enum": [
                    "768",
                    "576",
                    "480"
                  ],
                  "default": "768"
                },
                {
                  "name": "durationSec",
                  "type": "number",
                  "default": 5,
                  "min": 4,
                  "max": 15
                },
                {
                  "name": "steps",
                  "type": "number",
                  "default": 50,
                  "min": 10,
                  "max": 80
                },
                {
                  "name": "seed",
                  "type": "number",
                  "default": -1
                }
              ],
              "referenceFields": [
                {
                  "field": "referenceImages",
                  "role": "image",
                  "multiple": true
                },
                {
                  "field": "referenceVideos",
                  "role": "video",
                  "multiple": true
                },
                {
                  "field": "referenceAudios",
                  "role": "audio",
                  "multiple": true
                }
              ],
              "weights": {
                "huggingFace": "MiniMaxAI/MiniMax-H3",
                "modelScope": "",
                "revision": "main"
              },
              "referenceBudgets": [
                {
                  "maxImages": 9,
                  "maxVideos": 3,
                  "maxAudios": 3
                }
              ],
              "localized": {
                "zh": {
                  "name": "MiniMax-H3 极速版（Turbo 文/首尾帧 + 参考）"
                },
                "en": {
                  "name": "MiniMax-H3 Turbo (text/frames + reference)"
                }
              }
            },
            {
              "id": "qwen-image",
              "name": "Qwen-Image-2.1 文生图/参考生图",
              "capability": "image.generate",
              "runtime": "modal",
              "sizeGb": 33,
              "inputModes": [
                "text",
                "image"
              ],
              "parameters": [
                {
                  "name": "prompt",
                  "type": "string"
                },
                {
                  "name": "negativePrompt",
                  "type": "string",
                  "default": ""
                },
                {
                  "name": "aspectRatio",
                  "type": "string",
                  "enum": [
                    "1:1",
                    "16:9",
                    "9:16",
                    "4:3",
                    "3:4",
                    "3:2",
                    "2:3"
                  ]
                },
                {
                  "name": "resolution",
                  "type": "string",
                  "enum": [
                    "2048",
                    "1536",
                    "1024",
                    "768"
                  ],
                  "default": "1024"
                },
                {
                  "name": "steps",
                  "type": "number",
                  "default": 40,
                  "min": 1,
                  "max": 100
                },
                {
                  "name": "guidance",
                  "type": "number",
                  "default": 1.0,
                  "min": 0,
                  "max": 20
                },
                {
                  "name": "seed",
                  "type": "number",
                  "default": -1
                }
              ],
              "referenceFields": [
                {
                  "field": "references",
                  "role": "image",
                  "multiple": true
                }
              ],
              "weights": {
                "huggingFace": "Qwen/Qwen-Image-2.1",
                "modelScope": "Qwen/Qwen-Image-2.1",
                "revision": "main"
              },
              "referenceBudgets": [
                {
                  "maxImages": 10
                }
              ],
              "localized": {
                "zh": {
                  "name": "Qwen-Image-2.1 文生图/参考生图"
                },
                "en": {
                  "name": "Qwen-Image-2.1 t2i/edit"
                }
              }
            },
            {
              "id": "sd-turbo",
              "name": "SD-Turbo 文生图/图生图",
              "capability": "image.generate",
              "runtime": "modal",
              "sizeGb": 3,
              "inputModes": [
                "text"
              ],
              "parameters": [
                {
                  "name": "prompt",
                  "type": "string"
                },
                {
                  "name": "negativePrompt",
                  "type": "string",
                  "default": ""
                },
                {
                  "name": "aspectRatio",
                  "type": "string",
                  "enum": [
                    "1:1",
                    "16:9",
                    "9:16",
                    "4:3",
                    "3:4"
                  ],
                  "default": "1:1"
                },
                {
                  "name": "resolution",
                  "type": "string",
                  "enum": [
                    "512",
                    "384",
                    "256"
                  ],
                  "default": "512"
                },
                {
                  "name": "steps",
                  "type": "number",
                  "default": 2,
                  "min": 1,
                  "max": 8
                },
                {
                  "name": "guidance",
                  "type": "number",
                  "default": 0.0,
                  "min": 0,
                  "max": 10
                },
                {
                  "name": "seed",
                  "type": "number",
                  "default": -1
                }
              ],
              "referenceFields": [],
              "weights": {
                "huggingFace": "stabilityai/sd-turbo",
                "modelScope": "AI-ModelScope/sd-turbo",
                "revision": "main"
              },
              "localized": {
                "zh": {
                  "name": "SD-Turbo 文生图/图生图"
                },
                "en": {
                  "name": "SD-Turbo t2i/i2i"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "operations": [
    {
      "name": "modal.status",
      "surfaces": [
        "api",
        "mcp"
      ],
      "capability": true,
      "description": "检查 Modal token profile/连通性、各预设包的部署状态（app/function 是否存在）、volume 就绪度、stale（代码变更待重新部署）与在途任务。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "modal.overview",
      "surfaces": [
        "api"
      ],
      "description": "工作台首屏轻量负载：只读本机 registry/profiles/设置与上次就绪度快照（不拉起 modal CLI、不访问网络），返回 { modalapps:[…无就绪度字段时表示尚未探测…], profiles, defaultProfileId, downloadSource, defaultGpuTier, snapshot:{ modalapps, checkedAt } }；就绪度由 modal.status 后台刷新。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "modal.catalog",
      "surfaces": [
        "api",
        "mcp"
      ],
      "capability": true,
      "description": "枚举预设包/函数：返回 { modalapps:[{ id, label, capability, deployed, volumeReady, stale, gpuTiers, functions:[{ id, label, formSchema, defaultParams, output }] }] }。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "modal.profiles.add",
      "surfaces": [
        "api"
      ],
      "description": "新增 Modal token profile { name, tokenId, tokenSecret }（存 App 私有状态，0600）。",
      "inputSchema": {
        "type": "object",
        "required": [
          "name",
          "tokenId",
          "tokenSecret"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "tokenId": {
            "type": "string"
          },
          "tokenSecret": {
            "type": "string"
          },
          "makeDefault": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "modal.profiles.list",
      "surfaces": [
        "api"
      ],
      "description": "列出 Modal token profiles（不返回 secret，只返回 { id, name, tokenIdMasked, tokenSet }）。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "modal.profiles.remove",
      "surfaces": [
        "api"
      ],
      "description": "删除一个 Modal token profile。",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "modal.settings.set",
      "surfaces": [
        "api"
      ],
      "description": "持久化默认 profile、权重源（automatic/huggingface/modelscope）、默认 GPU 档位，以及某个「预设包 + 函数」的 AI 默认参数（agentDefaults）。AI 默认参数用于 Agent/平台默认路由调用 modal.generate 时补全未显式传入的字段。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "defaultProfileId": {
            "type": "string"
          },
          "downloadSource": {
            "type": "string",
            "enum": [
              "automatic",
              "huggingface",
              "modelscope"
            ]
          },
          "defaultGpuTier": {
            "type": "string"
          },
          "agentDefaults": {
            "type": "object",
            "description": "某函数的 AI 默认参数：{ modalapp, function, params }。params 为按 formSchema 的表单值对象，传空对象即清除。",
            "properties": {
              "modalapp": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "params": {
                "type": "object"
              }
            },
            "required": [
              "modalapp"
            ]
          }
        }
      }
    },
    {
      "name": "modal.secret.set",
      "surfaces": [
        "api"
      ],
      "description": "把 { name, values } 写成用户 Modal 账号下的 Secret（modal secret create --force），用于私有权重 token。",
      "inputSchema": {
        "type": "object",
        "required": [
          "name",
          "values"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "values": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "modal.secrets.list",
      "surfaces": [
        "api",
        "mcp"
      ],
      "description": "聚合所有预设包声明的 Secret（去重）并标注在当前账号是否已创建，供「账号」面板渲染 token/密钥设置项。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "modal.modalapp.list",
      "surfaces": [
        "api",
        "mcp"
      ],
      "description": "列出内置与用户预设包（含 origin、绝对路径、部署与 volume 就绪度、函数清单）。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "modal.modalapp.get",
      "surfaces": [
        "api",
        "mcp"
      ],
      "description": "读取单个预设包的归一 manifest、来源（builtin/user）、源码绝对路径与目录内文件清单。",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "modal.modalapp.path",
      "surfaces": [
        "api"
      ],
      "description": "返回内置与用户预设包根目录的绝对路径（供 Agent 用原生工具直接编辑用户预设包文件）。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "modal.modalapp.save",
      "surfaces": [
        "api",
        "mcp"
      ],
      "description": "创建/更新一个用户预设包（写入 appstate/modalapps/<id>/）：{ id, manifest, modalAppPy?, bootstrapPy? }；id 不可与内置撞名。",
      "inputSchema": {
        "type": "object",
        "required": [
          "id",
          "manifest"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "manifest": {
            "type": "object"
          },
          "modalAppPy": {
            "type": "string"
          },
          "bootstrapPy": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "modal.modalapp.scaffold",
      "surfaces": [
        "api",
        "mcp"
      ],
      "description": "生成一个可端到端跑通的最小用户预设包骨架（占位 1x1 图、无需权重）：{ id, name?, capability?, overwrite? }。",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "overwrite": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "modal.modalapp.remove",
      "surfaces": [
        "api",
        "mcp"
      ],
      "description": "删除一个用户预设包（appstate/modalapps/<id>/）；内置预设包不可删除。",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "modal.prepare",
      "surfaces": [
        "api"
      ],
      "description": "准备本机运行环境（安装主 venv 依赖并跑 App bootstrap.py）；异步单槽；不部署云端、不下载权重。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "modal.deploy",
      "surfaces": [
        "api",
        "mcp"
      ],
      "description": "部署/更新预设包的 Image 与函数（modal deploy）；异步单槽；{ modalapp }。",
      "inputSchema": {
        "type": "object",
        "required": [
          "modalapp"
        ],
        "properties": {
          "modalapp": {
            "type": "string"
          },
          "profileId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "modal.install",
      "surfaces": [
        "api",
        "mcp"
      ],
      "description": "只准备权重（跑 bootstrap 写 Volume，不重建 image）；异步、按预设包串行；{ modalapp, source }。",
      "inputSchema": {
        "type": "object",
        "required": [
          "modalapp"
        ],
        "properties": {
          "modalapp": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "automatic",
              "huggingface",
              "modelscope"
            ]
          },
          "profileId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "modal.generate",
      "surfaces": [
        "api",
        "mcp"
      ],
      "capability": true,
      "description": "调用云端函数：{ modalapp, function, ...formFields, referenceAssetIds?, gpuTier?, confirmCost? }；单槽 FIFO；返回 { job, taskId, generation:{id} }。",
      "inputSchema": {
        "type": "object",
        "required": [
          "modalapp",
          "function"
        ],
        "properties": {
          "modalapp": {
            "type": "string"
          },
          "function": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "referenceAssetIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gpuTier": {
            "type": "string"
          },
          "confirmCost": {
            "type": "boolean"
          },
          "profileId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "modal.generations",
      "surfaces": [
        "api",
        "mcp"
      ],
      "capability": true,
      "description": "已完成运行记录（私有产物 + savedAssetId）。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "modal.generation.complete",
      "surfaces": [
        "api"
      ],
      "description": "任务终态后读取产物（outputURL/尺寸/时长/seed/耗时/错误）。",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "modal.save",
      "surfaces": [
        "api",
        "mcp"
      ],
      "capability": true,
      "description": "把私有产物导入素材库（kind: image|video|audio），返回真实 assetId。",
      "inputSchema": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "video",
