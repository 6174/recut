{
  "id": "minimax-h3-ref",
  "name": {
    "zh": "MiniMax-H3 参考生视频·人脸保持档",
    "en": "MiniMax-H3 Reference-to-Video (face-preserving)"
  },
  "capability": "video.generate",
  "expose": [
    {
      "model": "minimax-h3-ref",
      "function": "reference-to-video"
    },
    {
      "model": "minimax-h3-face-refine",
      "function": "face-refine",
      "capability": "video.generate"
    }
  ],
  "engine": {
    "appName": "recut-minimax-h3-ref",
    "sourceDir": "modalapps/minimax-h3-ref",
    "image": {
      "base": "registry:lmsysorg/sglang:dev",
      "pythonVersion": "3.11",
      "apt": [],
      "pip": [
        "huggingface_hub",
        "requests",
        "onnxruntime-gpu",
        "opencv-python-headless",
        "av",
        "numpy",
        "pillow"
      ],
      "buildCommands": [
        "python -m pip install -e /sgl-workspace/sglang/python[diffusion]"
      ]
    },
    "gpuTiers": {
      "default": "RTX-PRO-6000",
      "options": [
        {
          "id": "rtxpro6000x1",
          "gpu": "RTX-PRO-6000",
          "label": {
            "zh": "RTX PRO 6000 ×1 · 96GB · $3.03/h · Ref2VA 8 步 · fp8 驻留 · GPU 快照（默认）",
            "en": "RTX PRO 6000 ×1 · 96GB · $3.03/h · Ref2VA 8-step · fp8 resident · GPU snapshot (default)"
          }
        },
        {
          "id": "h200x1",
          "gpu": "H200",
          "label": {
            "zh": "H200 ×1 · 141GB · $4.54/h · bf16 全驻留（含人脸阶段头寸）",
            "en": "H200 ×1 · 141GB · $4.54/h · fully resident bf16 (headroom for the face stage)"
          }
        },
        {
          "id": "b200x1",
          "gpu": "B200",
          "label": {
            "zh": "B200 ×1 · 183GB · $6.25/h · 原生 mxfp8/NVFP4",
            "en": "B200 ×1 · 183GB · $6.25/h · native mxfp8/NVFP4"
          }
        }
      ]
    },
    "concurrency": {
      "generate": 1,
      "deploy": 1
    },
    "timeoutSec": 3600,
    "idleTimeoutSec": 60,
    "volumes": [
      {
        "name": "recut-minimax-h3-models",
        "mount": "/models",
        "label": {
          "zh": "复用：MiniMax-H3 权重（本包只读 Ref2VA 分区，已由 minimax-h3 / -turbo 下好）",
          "en": "Reused: MiniMax-H3 weights (this pack reads only the Ref2VA partition)"
        }
      },
      {
        "name": "recut-minimax-h3-turbo-merged",
        "mount": "/merged",
        "label": {
          "zh": "复用：Turbo 离线合并的 ref2va-transformer（lightx2v ref2v 8 步）",
          "en": "Reused: turbo offline-merged ref2va-transformer (lightx2v ref2v 8-step)"
        }
      },
      {
        "name": "recut-minimax-h3-ref-face",
        "mount": "/face",
        "label": {
          "zh": "本包专有：人脸检测（YuNet）+ 修复（CodeFormer ONNX）小模型",
          "en": "This pack: face detection (YuNet) + restoration (CodeFormer ONNX) models"
        }
      },
      {
        "name": "recut-minimax-h3-ref-out",
        "mount": "/out",
        "label": {
          "zh": "产物中转（含保留的原始 mp4）",
          "en": "Output staging (incl. the retained raw mp4)"
        }
      }
    ],
    "secrets": [
      {
        "name": "recut-hf-token",
        "required": false,
        "label": {
          "zh": "Hugging Face Token（本包复用已有权重，通常不需要；仅在需要补下共享卷时使用）",
          "en": "Hugging Face token (this pack reuses existing weights; only needed to refill the shared volume)"
        },
        "keys": [
          "HF_TOKEN"
        ]
      }
    ],
    "artifacts": [
      {
        "key": "weights",
        "volume": "recut-minimax-h3-models",
        "marker": ".recut-download-complete"
      },
      {
        "key": "mergedRef2va",
        "volume": "recut-minimax-h3-turbo-merged",
        "marker": ".recut-merge-ref2va-complete"
      },
      {
        "key": "facemodels",
        "volume": "recut-minimax-h3-ref-face",
        "marker": ".recut-facemodels-complete"
      }
    ],
    "requires": {
      "reference-to-video": [
        "weights",
        "mergedRef2va"
      ],
      "face-refine": [
        "facemodels"
      ]
    }
  },
  "weights": {
    "bootstrapFunction": "bootstrap_weights",
    "repoHuggingFace": "MiniMaxAI/MiniMax-H3",
    "repoModelScope": "",
    "revision": "main",
    "sizeGb": 0,
    "files": []
  },
  "functions": [
    {
      "id": "reference-to-video",
      "name": {
        "zh": "参考生视频·人脸保持（图像/视频/音频参考，Ref2VA 8 步）",
        "en": "Reference to video, face-preserving (image/video/audio refs, Ref2VA 8-step)"
      },
      "entrypoint": "generate_video",
      "minReferences": 1,
      "invoke": {
        "mode": "sdk",
        "kind": "cls",
        "cls": "H3Ref",
        "method": "generate_video"
      },
      "output": {
        "kind": "video",
        "mimeType": "video/mp4",
        "ext": "mp4"
      },
      "formSchema": [
        {
          "key": "prompt",
          "type": "textarea",
          "required": true,
          "placeholder": {
            "zh": "用 <Picture 1>/<Video 1>/<Audio 1> 引用素材，例如：<Picture 1> 里的角色在雨中撑伞前行",
            "en": "Reference materials as <Picture 1>/<Video 1>/<Audio 1>, e.g. the character in <Picture 1> walks in the rain"
          },
          "label": {
            "zh": "提示词（用 <Picture 1>/<Video 1>/<Audio 1> 引用素材）",
            "en": "Prompt (reference materials as <Picture 1>/<Video 1>/<Audio 1>)"
          }
        },
        {
          "key": "referenceImages",
          "type": "media",
          "kind": "image",
          "multiple": true,
          "label": {
            "zh": "参考图（最多 9 张，按顺序）——人脸保持的关键输入",
            "en": "Reference images (up to 9, in order) — the key input for face preservation"
          }
        },
        {
          "key": "referenceVideos",
          "type": "media",
          "kind": "video",
          "multiple": true,
          "label": {
            "zh": "参考视频（最多 3 段，每段 2–15s）",
            "en": "Reference videos (up to 3, 2-15s each)"
          }
        },
        {
          "key": "referenceAudios",
          "type": "media",
          "kind": "audio",
          "multiple": true,
          "label": {
            "zh": "参考音频（最多 3 段，每段 2–15s）",
            "en": "Reference audios (up to 3, 2-15s each)"
          }
        },
        {
          "key": "aspectRatio",
          "type": "select",
          "options": [
            "21:9",
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16"
          ],
          "default": "16:9",
          "label": {
            "zh": "画幅",
            "en": "Aspect ratio"
          },
          "hint": {
            "zh": "输出画幅；参考素材只作语义参考，不继承其尺寸。分辨率按最长边理解，短边由画幅推导。",
            "en": "Output ratio; references are semantic only. Resolution is the longest edge; the short edge follows this ratio."
          }
        },
        {
          "key": "resolution",
          "type": "select",
          "options": [
            "1536",
            "1024",
            "768"
          ],
          "default": "1536",
          "label": {
            "zh": "分辨率（最长边 px）",
            "en": "Resolution (longest edge px)"
          },
          "hint": {
            "zh": "最长边像素，短边按画幅推导：只下调不超分。1536 在 16:9 下即 H3 原生 768p。",
            "en": "Longest-edge pixels; only down-scaling. 1536 at 16:9 equals H3's native 768p."
          }
        },
        {
          "key": "durationSec",
          "type": "number",
          "default": 5,
          "min": 4,
          "max": 15,
          "label": {
            "zh": "时长（秒）",
            "en": "Duration (s)"
          }
        },
        {
          "key": "steps",
          "type": "number",
          "default": 9,
          "min": 5,
          "max": 12,
          "label": {
            "zh": "步数（Ref2VA Turbo：请求＝sigma 网格点数＝去噪次数+1；8 次去噪 → 9）",
            "en": "Steps (Ref2VA Turbo: request = sigma grid points = denoise evals + 1; 8 evals → 9)"
          },
          "hint": {
            "zh": "8 次去噪是社区公认的脸部/微细节甜点区；低于 4 次脸部会明显变差。改动会偏离蒸馏调度。",
            "en": "8 denoise evals is the community sweet spot for faces/micro-detail; fewer than 4 degrades faces. Changing it deviates from the distilled schedule."
          }
        },
        {
          "key": "seed",
          "type": "number",
          "default": -1,
          "randomizable": true,
          "label": {
            "zh": "随机种子（-1 随机）",
            "en": "Seed (-1 random)"
          }
        },
        {
          "key": "referenceSheet",
          "type": "select",
          "options": [
            "auto",
            "off"
          ],
          "default": "auto",
          "label": {
            "zh": "参考组增强（从参考图裁出人脸拼成角色参考组）",
            "en": "Reference-sheet enhancement (crop faces from refs into a character sheet)"
          },
          "hint": {
            "zh": "把参考图里的人脸裁出放大拼成一张「角色参考组」追加为最后一张参考图，加强身份锚定（人脸保持的第一杠杆）。追加在末尾，不影响你原有的 <Picture 1..N> 编号。",
            "en": "Crops faces from your reference images into one character sheet appended as the last reference, strengthening identity anchoring. Appended last, so your <Picture 1..N> numbering is unaffected."
          }
        },
        {
          "key": "faceRefine",
          "type": "select",
          "options": [
            "auto",
            "off",
            "codeformer",
            "gfpgan"
          ],
          "default": "auto",
          "label": {
            "zh": "人脸修复（生成后处理，远景/中景小脸）",
            "en": "Face refinement (post, distant/mid faces)"
          },
          "hint": {
            "zh": "生成后逐帧检测并修复小脸（源脸 <40px 自动切远景档）；只动画面，原生音轨原样保留；原始视频一并保留，可只重跑修复。近景特写可设 off。",
            "en": "Detects and refines small faces after generation (auto long-shot profile when the source face is <40px). Video-only; the native audio track is copied unchanged; the raw video is retained for a repair-only re-run."
          }
        },
        {
          "key": "faceFidelity",
          "type": "number",
          "default": 0.6,
          "min": 0.0,
          "max": 1.0,
          "label": {
            "zh": "修复保真度",
            "en": "Refine fidelity"
          },
          "hint": {
            "zh": "越大越清晰、越小越像原脸（仅 codeformer 生效）。",
            "en": "Higher = sharper, lower = closer to the original face (codeformer only)."
          }
        },
        {
          "key": "faceCropFactor",
          "type": "number",
          "default": 2.5,
          "min": 1.5,
          "max": 4.0,
          "label": {
            "zh": "裁剪外扩倍数（远景建议 3.5）",
            "en": "Crop factor (3.5 for long shots)"
          }
        },
        {
          "key": "faceCanvasSize",
          "type": "select",
          "options": [
            "512",
            "768"
          ],
          "default": "768",
          "label": {
            "zh": "修复画布（远景小脸会自动降到 512）",
            "en": "Refine canvas (auto-drops to 512 for distant faces)"
          }
        },
        {
          "key": "facePersonFallback",
          "type": "boolean",
          "default": false,
          "label": {
            "zh": "远景丢帧兜底（用人体框顶部反推头部）",
            "en": "Person fallback (locate the head from the body box)"
          },
          "hint": {
            "zh": "仅在纯远景、人脸框频繁丢失时开；中景/夜景开了会把裁剪框拉偏。",
            "en": "Enable only for pure long shots where the face box is frequently lost; it can mis-crop mid shots/night scenes."
          }
        },
        {
          "key": "keepRaw",
          "type": "boolean",
          "default": true,
          "label": {
            "zh": "保留原始产物（便于只重跑修复）",
            "en": "Keep the raw output (for a repair-only re-run)"
          }
        }
      ],
      "defaultParams": {
        "aspectRatio": "16:9",
        "resolution": "1536",
        "durationSec": 5,
        "steps": 9,
        "referenceSheet": "auto",
        "faceRefine": "auto"
      },
      "referenceBudgets": [
        {
          "maxImages": 9,
          "maxVideos": 3,
          "maxAudios": 3
        }
      ]
    },
    {
      "id": "face-refine",
      "name": {
        "zh": "人脸修复（对已有视频，视频→视频）",
        "en": "Face refine (existing video → video)"
      },
      "entrypoint": "refine_video",
      "minReferences": 1,
      "invoke": {
        "mode": "sdk",
        "kind": "cls",
        "cls": "H3FaceRefine",
        "method": "refine_video"
      },
      "output": {
        "kind": "video",
        "mimeType": "video/mp4",
        "ext": "mp4"
      },
      "formSchema": [
        {
          "key": "referenceVideos",
          "type": "media",
          "kind": "video",
          "multiple": false,
          "label": {
            "zh": "待修复的视频",
            "en": "Video to refine"
          }
        },
        {
          "key": "faceRefine",
          "type": "select",
          "options": [
            "codeformer",
            "gfpgan"
          ],
          "default": "codeformer",
          "label": {
            "zh": "修复模型",
            "en": "Refine model"
          }
        },
        {
          "key": "faceFidelity",
          "type": "number",
          "default": 0.6,
          "min": 0.0,
          "max": 1.0,
          "label": {
            "zh": "修复保真度",
            "en": "Refine fidelity"
          }
        },
        {
          "key": "faceCropFactor",
          "type": "number",
          "default": 2.5,
          "min": 1.5,
          "max": 4.0,
          "label": {
            "zh": "裁剪外扩倍数（远景建议 3.5）",
            "en": "Crop factor (3.5 for long shots)"
          }
        },
        {
          "key": "faceCanvasSize",
          "type": "select",
          "options": [
            "512",
            "768"
          ],
          "default": "768",
          "label": {
            "zh": "修复画布（远景小脸会自动降到 512）",
            "en": "Refine canvas (auto-drops to 512 for distant faces)"
          }
        },
        {
          "key": "facePersonFallback",
          "type": "boolean",
          "default": false,
          "label": {
            "zh": "远景丢帧兜底",
            "en": "Person fallback"
          }
        }
      ],
      "defaultParams": {
        "faceRefine": "codeformer",
        "faceFidelity": 0.6
      },
      "referenceBudgets": [
        {
          "maxVideos": 1
        }
      ]
    }
  ]
}
