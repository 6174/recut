{
  "id": "minimax-h3-one",
  "name": {
    "zh": "MiniMax-H3 单卡（文/首尾帧/参考，GPU 快照）",
    "en": "MiniMax-H3 single-GPU (text/frames/reference)"
  },
  "capability": "video.generate",
  "expose": {
    "model": "minimax-h3-one",
    "function": "reference-to-video"
  },
  "engine": {
    "appName": "recut-minimax-h3-one",
    "sourceDir": "modalapps/minimax-h3-one",
    "image": {
      "base": "registry:lmsysorg/sglang:dev",
      "pythonVersion": "3.11",
      "apt": [],
      "pip": [
        "huggingface_hub",
        "requests"
      ],
      "buildCommands": [
        "python -m pip install -e /sgl-workspace/sglang/python[diffusion]"
      ]
    },
    "gpuTiers": {
      "default": "RTX-PRO-6000",
      "options": [
        {
          "id": "rtxpro6000x1",
          "gpu": "RTX-PRO-6000",
          "label": {
            "zh": "RTX PRO 6000 ×1 · 96GB · $3.03/h · 5s片≈8min（默认最省）",
            "en": "RTX PRO 6000 ×1 · 96GB · $3.03/h · ~8min/5s (default, cheapest)"
          }
        },
        {
          "id": "h100x1",
          "gpu": "H100",
          "label": {
            "zh": "H100 ×1 · 80GB · $3.95/h · 5s片≈4min",
            "en": "H100 ×1 · 80GB · $3.95/h · ~4min/5s"
          }
        },
        {
          "id": "h200x1",
          "gpu": "H200",
          "label": {
            "zh": "H200 ×1 · 141GB · $4.54/h · 5s片≈3min",
            "en": "H200 ×1 · 141GB · $4.54/h · ~3min/5s"
          }
        },
        {
          "id": "b200x1",
          "gpu": "B200",
          "label": {
            "zh": "B200 ×1 · 192GB · $6.25/h · 5s片≈2min",
            "en": "B200 ×1 · 192GB · $6.25/h · ~2min/5s"
          }
        },
        {
          "id": "b300x1",
          "gpu": "B300",
          "label": {
            "zh": "B300 ×1 · 288GB · $7.10/h · 5s片≈1.5min",
            "en": "B300 ×1 · 288GB · $7.10/h · ~1.5min/5s"
          }
        }
      ]
    },
    "timeoutSec": 3600,
    "idleTimeoutSec": 60,
    "volumes": [
      {
        "name": "recut-minimax-h3-models",
        "mount": "/models",
        "label": {
          "zh": "模型权重（FL2VA，约 134GB；与 minimax-h3 共用）",
          "en": "Model weights (FL2VA, ~134GB; shared with minimax-h3)"
        }
      },
      {
        "name": "recut-minimax-h3-one-out",
        "mount": "/out",
        "label": {
          "zh": "产物中转",
          "en": "Output staging"
        }
      }
    ],
    "secrets": [
      {
        "name": "recut-hf-token",
        "required": true,
        "label": {
          "zh": "Hugging Face Token（H3 需申请访问权限，必填）",
          "en": "Hugging Face token (H3 is gated, required)"
        },
        "keys": [
          "HF_TOKEN"
        ]
      }
    ]
  },
  "weights": {
    "bootstrapFunction": "bootstrap_weights",
    "repoHuggingFace": "MiniMaxAI/MiniMax-H3",
    "repoModelScope": "",
    "revision": "main",
    "sizeGb": 270,
    "files": [
      "model_index.json",
      "FL2VA/**",
      "Ref2VA/**"
    ]
  },
  "functions": [
    {
      "id": "text-to-video",
      "name": {
        "zh": "文生视频（带音频）",
        "en": "Text to video+audio"
      },
      "entrypoint": "generate_video",
      "invoke": {
        "mode": "sdk",
        "kind": "cls",
        "cls": "H3One",
        "method": "generate_video"
      },
      "output": {
        "kind": "video",
        "mimeType": "video/mp4",
        "ext": "mp4"
      },
      "formSchema": [
        {
          "key": "prompt",
          "type": "textarea",
          "required": true,
          "label": {
            "zh": "提示词",
            "en": "Prompt"
          }
        },
        {
          "key": "aspectRatio",
          "type": "select",
          "options": [
            "21:9",
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16"
          ],
          "default": "16:9",
          "label": {
            "zh": "画幅",
            "en": "Aspect ratio"
          }
        },
        {
          "key": "durationSec",
          "type": "number",
          "default": 5,
          "min": 4,
          "max": 15,
          "label": {
            "zh": "时长（秒）",
            "en": "Duration (s)"
          }
        },
        {
          "key": "steps",
          "type": "number",
          "default": 50,
          "min": 10,
          "max": 80,
          "label": {
            "zh": "步数",
            "en": "Steps"
          }
        },
        {
          "key": "seed",
          "type": "number",
          "default": -1,
          "label": {
            "zh": "随机种子（-1 随机）",
            "en": "Seed (-1 random)"
          }
        }
      ],
      "defaultParams": {
        "aspectRatio": "16:9",
        "durationSec": 5,
        "steps": 50
      }
    },
    {
      "id": "first-last-frame",
      "name": {
        "zh": "首/尾帧生视频",
        "en": "First/last-frame to video"
      },
      "entrypoint": "generate_video",
      "invoke": {
        "mode": "sdk",
        "kind": "cls",
        "cls": "H3One",
        "method": "generate_video"
      },
      "output": {
        "kind": "video",
        "mimeType": "video/mp4",
        "ext": "mp4"
      },
      "formSchema": [
        {
          "key": "prompt",
          "type": "textarea",
          "required": true,
          "label": {
            "zh": "提示词",
            "en": "Prompt"
          }
        },
        {
          "key": "firstFrame",
          "type": "media",
          "kind": "image",
          "multiple": false,
          "label": {
            "zh": "首帧（可选）",
            "en": "First frame (optional)"
          }
        },
        {
          "key": "lastFrame",
          "type": "media",
          "kind": "image",
          "multiple": false,
          "label": {
            "zh": "尾帧（可选）",
            "en": "Last frame (optional)"
          }
        },
        {
          "key": "durationSec",
          "type": "number",
          "default": 5,
          "min": 4,
          "max": 15,
          "label": {
            "zh": "时长（秒）",
            "en": "Duration (s)"
          }
        },
        {
          "key": "steps",
          "type": "number",
          "default": 50,
          "min": 10,
          "max": 80,
          "label": {
            "zh": "步数",
            "en": "Steps"
          }
        },
        {
          "key": "seed",
          "type": "number",
          "default": -1,
          "label": {
            "zh": "随机种子（-1 随机）",
            "en": "Seed (-1 random)"
          }
        }
      ],
      "defaultParams": {
        "durationSec": 5,
        "steps": 50
      },
      "minReferences": 1,
      "referenceBudgets": [
        {
          "requirements": [
            "images>=1"
          ],
          "maxImages": 2
        }
      ]
    },
    {
      "id": "reference-to-video",
      "name": {
        "zh": "参考生视频（图像/视频/音频）",
        "en": "Reference to video (image/video/audio)"
      },
      "entrypoint": "generate_video",
      "minReferences": 1,
      "invoke": {
        "mode": "sdk",
        "kind": "cls",
        "cls": "H3OneRef",
        "method": "generate_video"
      },
      "output": {
        "kind": "video",
        "mimeType": "video/mp4",
        "ext": "mp4"
      },
      "formSchema": [
        {
          "key": "prompt",
          "type": "textarea",
          "required": true,
          "label": {
            "zh": "提示词（用 <Picture 1>/<Video 1>/<Audio 1> 引用素材）",
            "en": "Prompt (reference materials as <Picture 1>/<Video 1>/<Audio 1>)"
          }
        },
        {
          "key": "referenceImages",
          "type": "media",
          "kind": "image",
          "multiple": true,
          "label": {
            "zh": "参考图（最多 9 张，按顺序）",
            "en": "Reference images (up to 9, in order)"
          }
        },
        {
          "key": "referenceVideos",
          "type": "media",
          "kind": "video",
          "multiple": true,
          "label": {
            "zh": "参考视频（最多 3 段，每段 2–15s）",
            "en": "Reference videos (up to 3, 2-15s each)"
          }
        },
        {
          "key": "referenceAudios",
          "type": "media",
          "kind": "audio",
          "multiple": true,
          "label": {
            "zh": "参考音频（最多 3 段，每段 2–15s）",
            "en": "Reference audios (up to 3, 2-15s each)"
          }
        },
        {
          "key": "durationSec",
          "type": "number",
          "default": 5,
          "min": 4,
          "max": 15,
          "label": {
            "zh": "时长（秒）",
            "en": "Duration (s)"
          }
        },
        {
          "key": "steps",
          "type": "number",
          "default": 50,
          "min": 10,
          "max": 80,
          "label": {
            "zh": "步数",
            "en": "Steps"
          }
        },
        {
          "key": "seed",
          "type": "number",
          "default": -1,
          "label": {
            "zh": "随机种子（-1 随机）",
            "en": "Seed (-1 random)"
          }
        }
      ],
      "defaultParams": {
        "durationSec": 5,
        "steps": 50
      },
      "referenceBudgets": [
        {
          "maxImages": 9,
          "maxVideos": 3,
          "maxAudios": 3
        }
      ]
    }
  ]
}
