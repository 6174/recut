{
  "id": "qwen-image-2.1",
  "name": {
    "zh": "Qwen-Image-2.1 文生图/参考生图",
    "en": "Qwen-Image-2.1 t2i/edit"
  },
  "capability": "image.generate",
  "expose": [
    {
      "model": "qwen-image",
      "name": {
        "zh": "Qwen-Image-2.1 文生图",
        "en": "Qwen-Image-2.1 text-to-image"
      },
      "function": "text-to-image",
      "parameters": [
        "resolution"
      ]
    },
    {
      "model": "qwen-image-edit",
      "name": {
        "zh": "Qwen-Image-2.1 图像编辑",
        "en": "Qwen-Image-2.1 image edit"
      },
      "function": "image-edit",
      "parameters": [
        "resolution"
      ]
    }
  ],
  "engine": {
    "appName": "recut-qwen-image-21",
    "sourceDir": "modalapps/qwen-image-2.1",
    "image": {
      "base": "debian_slim",
      "pythonVersion": "3.11",
      "apt": [
        "git"
      ],
      "pip": [
        "torch",
        "torchvision",
        "accelerate",
        "pillow",
        "safetensors",
        "transformers>=5.17",
        "huggingface_hub",
        "sentencepiece",
        "git+https://github.com/huggingface/diffusers"
      ]
    },
    "gpuTiers": {
      "default": "A100-80GB",
      "options": [
        {
          "id": "a100-80gb",
          "gpu": "A100-80GB",
          "label": {
            "zh": "A100 80GB ×1（推荐，默认档）",
            "en": "A100 80GB ×1 (recommended, default)"
          }
        },
        {
          "id": "h100",
          "gpu": "H100",
          "label": {
            "zh": "H100 ×1（更快）",
            "en": "H100 ×1 (faster)"
          }
        },
        {
          "id": "h200",
          "gpu": "H200",
          "label": {
            "zh": "H200 ×1（最快）",
            "en": "H200 ×1 (fastest)"
          }
        },
        {
          "id": "l40s",
          "gpu": "L40S",
          "label": {
            "zh": "L40S ×1 · 48GB（仅在把分辨率降到 1024/768 时可用）",
            "en": "L40S ×1 · 48GB (only usable if you drop resolution to 1024/768)"
          }
        }
      ]
    },
    "timeoutSec": 1800,
    "idleTimeoutSec": 60,
    "volumes": [
      {
        "name": "recut-qwen-image-21-models",
        "mount": "/models",
        "label": {
          "zh": "模型权重（约 33GB）",
          "en": "Model weights (~33GB)"
        }
      }
    ],
    "secrets": [
      {
        "name": "recut-hf-token",
        "required": false,
        "label": {
          "zh": "Hugging Face Token（权重需授权时需要）",
          "en": "Hugging Face token (when weights are gated)"
        },
        "keys": [
          "HF_TOKEN"
        ]
      }
    ]
  },
  "weights": {
    "bootstrapFunction": "bootstrap_weights",
    "repoHuggingFace": "Qwen/Qwen-Image-2.1",
    "repoModelScope": "Qwen/Qwen-Image-2.1",
    "revision": "main",
    "sizeGb": 33,
    "files": [
      "*.json",
      "*.txt",
      "transformer/*",
      "text_encoder/*",
      "tokenizer/*",
      "processor/*",
      "vae/*",
      "scheduler/*"
    ]
  },
  "functions": [
    {
      "id": "text-to-image",
      "name": {
        "zh": "文生图",
        "en": "Text to image"
      },
      "entrypoint": "generate_image",
      "invoke": {
        "mode": "sdk",
        "kind": "cls",
        "cls": "QwenImage21",
        "method": "generate_image"
      },
      "output": {
        "kind": "image",
        "mimeType": "image/png",
        "ext": "png"
      },
      "formSchema": [
        {
          "key": "prompt",
          "type": "textarea",
          "required": true,
          "placeholder": {
            "zh": "例如：一只蓝色的可爱的玩具小飞机，柔和的阳光，干净背景",
            "en": "e.g. a cute blue toy plane, soft sunlight, clean background"
          },
          "label": {
            "zh": "提示词",
            "en": "Prompt"
          }
        },
        {
          "key": "aspectRatio",
          "type": "select",
          "options": [
            "1:1",
            "16:9",
            "9:16",
            "4:3",
            "3:4",
            "3:2",
            "2:3"
          ],
          "default": "1:1",
          "label": {
            "zh": "画幅",
            "en": "Aspect ratio"
          }
        },
        {
          "key": "resolution",
          "type": "select",
          "options": [
            "2752",
            "2048",
            "1536",
            "1024"
          ],
          "default": "2752",
          "label": {
            "zh": "分辨率（最长边 px）",
            "en": "Resolution (longest edge px)"
          },
          "hint": {
            "zh": "默认 2752 即保持官方原生 2K 画幅（各画幅原生长边 2048–2752，取「不小于原生长边就保持原生」），直出就是官方效果；只在想更快/更省额度时才下调。",
            "en": "The default 2752 keeps the official native 2K size (native long edge is 2048–2752; anything ≥ native stays native), so the default already matches the official recipe. Lower it only for speed."
          }
        },
        {
          "key": "steps",
          "type": "number",
          "default": 40,
          "min": 1,
          "max": 100,
          "label": {
            "zh": "步数",
            "en": "Steps"
          }
        },
        {
          "key": "seed",
          "type": "number",
          "default": -1,
          "randomizable": true,
          "label": {
            "zh": "随机种子（-1 随机）",
            "en": "Seed (-1 random)"
          }
        }
      ],
      "defaultParams": {
        "aspectRatio": "1:1",
        "resolution": "2752",
        "steps": 40
      }
    },
    {
      "id": "image-edit",
      "name": {
        "zh": "图像编辑",
        "en": "Image edit"
      },
      "entrypoint": "edit_image",
      "invoke": {
        "mode": "sdk",
        "kind": "cls",
        "cls": "QwenImage21",
        "method": "edit_image"
      },
      "output": {
        "kind": "image",
        "mimeType": "image/png",
        "ext": "png"
      },
      "formSchema": [
        {
          "key": "prompt",
          "type": "textarea",
          "required": true,
          "placeholder": {
            "zh": "例如：把背景换成黄昏的海边，保持主体不变",
            "en": "e.g. replace the background with a seaside at dusk, keep the subject"
          },
          "label": {
            "zh": "编辑指令",
            "en": "Edit instruction"
          }
        },
        {
          "key": "references",
          "type": "media",
          "kind": "image",
          "multiple": true,
          "required": true,
          "label": {
            "zh": "参考图（最多 10 张，按顺序）",
            "en": "Reference images (up to 10, in order)"
          }
        },
        {
          "key": "aspectRatio",
          "type": "select",
          "options": [
            "1:1",
            "16:9",
            "9:16",
            "4:3",
            "3:4",
            "3:2",
            "2:3"
          ],
          "placeholder": {
            "zh": "跟随参考图",
            "en": "Follow reference"
          },
          "label": {
            "zh": "画幅",
            "en": "Aspect ratio"
          },
          "hint": {
            "zh": "留空则输出尺寸跟随参考图；指定画幅后按「画幅 + 分辨率」出图。",
            "en": "Leave empty to follow the reference size; once set, the output uses this ratio plus the resolution."
          }
        },
        {
          "key": "resolution",
          "type": "select",
          "options": [
            "2752",
            "2048",
            "1536",
            "1024"
          ],
          "default": "2752",
          "label": {
            "zh": "分辨率（最长边 px）",
            "en": "Resolution (longest edge px)"
          },
          "hint": {
            "zh": "仅在指定画幅时生效（留空画幅＝按参考图比例出图）。默认 2752 即保持官方原生 2K 画幅，直出就是官方效果；只在想更快/更省额度时才下调。",
            "en": "Only used when an aspect ratio is set (an empty ratio follows the reference). The default 2752 keeps the official native 2K size — the official recipe out of the box. Lower it only for speed."
          }
        },
        {
          "key": "steps",
          "type": "number",
          "default": 40,
          "min": 1,
          "max": 100,
          "label": {
            "zh": "步数",
            "en": "Steps"
          }
        },
        {
          "key": "seed",
          "type": "number",
          "default": -1,
          "randomizable": true,
          "label": {
            "zh": "随机种子（-1 随机）",
            "en": "Seed (-1 random)"
          }
        }
      ],
      "defaultParams": {
        "steps": 40
      },
      "referenceBudgets": [
        {
          "maxImages": 10
        }
      ],
      "minReferences": 1
    }
  ]
}
