{
  "id": "minimax-h3-turbo",
  "name": {
    "zh": "MiniMax-H3 极速版（Turbo 离线合并 + GPU 快照）",
    "en": "MiniMax-H3 Turbo (offline-merged LoRA + GPU snapshot)"
  },
  "capability": "video.generate",
  "expose": { "model": "minimax-h3-turbo", "function": "text-to-video" },
  "engine": {
    "appName": "recut-minimax-h3-turbo",
    "sourceDir": "modalapps/minimax-h3-turbo",
    "image": {
      "base": "registry:lmsysorg/sglang:dev",
      "pythonVersion": "3.11",
      "apt": [],
      "pip": [
        "huggingface_hub",
        "requests"
      ],
      "buildCommands": [
        "python -m pip install -e /sgl-workspace/sglang/python[diffusion]"
      ]
    },
    "gpuTiers": {
      "default": "RTX-PRO-6000",
      "options": [
        {
          "id": "rtxpro6000x1",
          "gpu": "RTX-PRO-6000",
          "label": {
            "zh": "RTX PRO 6000 ×1 · 96GB · $3.03/h · Turbo 9步 · GPU 快照（默认最省）",
            "en": "RTX PRO 6000 ×1 · 96GB · $3.03/h · Turbo 9-step · GPU snapshot (default, cheapest)"
          }
        },
        {
          "id": "h200x1",
          "gpu": "H200",
          "label": {
            "zh": "H200 ×1 · 141GB · $4.54/h · bf16 全驻留",
            "en": "H200 ×1 · 141GB · $4.54/h · fully resident bf16"
          }
        },
        {
          "id": "b200x1",
          "gpu": "B200",
          "label": {
            "zh": "B200 ×1 · 183GB · $6.25/h · 原生 mxfp8/NVFP4",
            "en": "B200 ×1 · 183GB · $6.25/h · native mxfp8/NVFP4"
          }
        },
        {
          "id": "b300x1",
          "gpu": "B300",
          "label": {
            "zh": "B300 ×1 · 288GB · $7.10/h · 单卡上限",
            "en": "B300 ×1 · 288GB · $7.10/h · single-GPU ceiling"
          }
        }
      ]
    },
    "timeoutSec": 3600,
    "idleTimeoutSec": 60,
    "volumes": [
      {
        "name": "recut-minimax-h3-models",
        "mount": "/models",
        "label": {
          "zh": "模型权重（FL2VA，约 134GB；与 minimax-h3 / minimax-h3-one 共用，只读复用免重下）",
          "en": "Model weights (FL2VA, ~134GB; shared with minimax-h3 / minimax-h3-one, reused read-only)"
        }
      },
      {
        "name": "recut-minimax-h3-turbo-adapters",
        "mount": "/adapters",
        "label": {
          "zh": "Turbo LoRA 适配器（几百 MB）",
          "en": "Turbo LoRA adapter (a few hundred MB)"
        }
      },
      {
        "name": "recut-minimax-h3-turbo-merged",
        "mount": "/merged",
        "label": {
          "zh": "Turbo 离线合并后的 transformer（约 62GB，bootstrap_merge 写入）",
          "en": "Turbo offline-merged transformer (~62GB, written by bootstrap_merge)"
        }
      },
      {
        "name": "recut-minimax-h3-turbo-out",
        "mount": "/out",
        "label": {
          "zh": "产物中转",
          "en": "Output staging"
        }
      }
    ],
    "secrets": [
      {
        "name": "recut-hf-token",
        "required": true,
        "label": {
          "zh": "Hugging Face Token（H3 需申请访问权限，必填；若共享权重卷已就绪则权重部分短路）",
          "en": "Hugging Face token (H3 is gated, required; weight step short-circuits if the shared volume is ready)"
        },
        "keys": [
          "HF_TOKEN"
        ]
      }
    ]
  },
  "weights": {
    "bootstrapFunction": "bootstrap_weights",
    "repoHuggingFace": "MiniMaxAI/MiniMax-H3",
    "repoModelScope": "",
    "revision": "main",
    "sizeGb": 135,
    "files": [
      "model_index.json",
      "FL2VA/**"
    ]
  },
  "functions": [
    {
      "id": "text-to-video",
      "name": {
        "zh": "文生视频（带音频）",
        "en": "Text to video+audio"
      },
      "entrypoint": "generate_video",
      "invoke": {
        "mode": "sdk",
        "kind": "cls",
        "cls": "H3Turbo",
        "method": "generate_video"
      },
      "output": {
        "kind": "video",
        "mimeType": "video/mp4",
        "ext": "mp4"
      },
      "formSchema": [
        {
          "key": "prompt",
          "type": "textarea",
          "required": true,
          "label": {
            "zh": "提示词",
            "en": "Prompt"
          }
        },
        {
          "key": "aspectRatio",
          "type": "select",
          "options": [
            "21:9",
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16"
          ],
          "default": "16:9",
          "label": {
            "zh": "画幅",
            "en": "Aspect ratio"
          }
        },
        {
          "key": "durationSec",
          "type": "number",
          "default": 5,
          "min": 4,
          "max": 15,
          "label": {
            "zh": "时长（秒）",
            "en": "Duration (s)"
          }
        },
        {
          "key": "steps",
          "type": "number",
          "default": 9,
          "min": 5,
          "max": 12,
          "label": {
            "zh": "步数（Turbo：请求＝sigma 网格点数＝去噪次数+1；作者建议 4–8 次去噪 → 5–9）",
            "en": "Steps (Turbo: request = sigma grid points = denoise evals + 1; author recommends 4-8 evals → 5-9)"
          }
        },
        {
          "key": "seed",
          "type": "number",
          "default": -1,
          "label": {
            "zh": "随机种子（-1 随机）",
            "en": "Seed (-1 random)"
          }
        }
      ],
      "defaultParams": {
        "aspectRatio": "16:9",
        "durationSec": 5,
        "steps": 9
      }
    },
    {
      "id": "first-last-frame",
      "name": {
        "zh": "首/尾帧生视频",
        "en": "First/last-frame to video"
      },
      "entrypoint": "generate_video",
      "invoke": {
        "mode": "sdk",
        "kind": "cls",
        "cls": "H3Turbo",
        "method": "generate_video"
      },
      "output": {
        "kind": "video",
        "mimeType": "video/mp4",
        "ext": "mp4"
      },
      "formSchema": [
        {
          "key": "prompt",
          "type": "textarea",
          "required": true,
          "label": {
            "zh": "提示词",
            "en": "Prompt"
          }
        },
        {
          "key": "references",
          "type": "media",
          "kind": "image",
          "multiple": true,
          "required": true,
          "label": {
            "zh": "首帧 / 尾帧（1–2 张，按顺序）",
            "en": "First / last frame (1–2 images, in order)"
          }
        },
        {
          "key": "durationSec",
          "type": "number",
          "default": 5,
          "min": 4,
          "max": 15,
          "label": {
            "zh": "时长（秒）",
            "en": "Duration (s)"
          }
        },
        {
          "key": "steps",
          "type": "number",
          "default": 9,
          "min": 5,
          "max": 12,
          "label": {
            "zh": "步数（Turbo：请求＝sigma 网格点数＝去噪次数+1；作者建议 4–8 次去噪 → 5–9）",
            "en": "Steps (Turbo: request = sigma grid points = denoise evals + 1; author recommends 4-8 evals → 5-9)"
          }
        },
        {
          "key": "seed",
          "type": "number",
          "default": -1,
          "label": {
            "zh": "随机种子（-1 随机）",
            "en": "Seed (-1 random)"
          }
        }
      ],
      "defaultParams": {
        "durationSec": 5,
        "steps": 9
      }
    }
  ]
}
