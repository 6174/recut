fn earthLandPoint(lat: f32, lon: f32) -> bool {
  let uu = fract((lon + PI) / TWO_PI);
  let vv = clamp((HALF_PI - lat) / PI, 0.0, 0.99999);
  let col = clamp(i32(uu * f32(EARTH_W)), 0, EARTH_W - 1);
  let row = clamp(i32(vv * f32(EARTH_H)), 0, EARTH_H - 1);
  let widx = row * EARTH_WORDS_PER_ROW + (col / 32);
  let bit = u32(col % 32);
  return ((EARTH_MASK[widx] >> bit) & 1u) != 0u;
}

fn earthLandHits(lat: f32, lon: f32, dLat: f32, dLon: f32) -> i32 {
  var hits = 0;
  for (var j = -1; j <= 1; j = j + 1) {
    for (var i = -1; i <= 1; i = i + 1) {
      if (earthLandPoint(lat + f32(j) * dLat * 0.4, lon + f32(i) * dLon * 0.4)) {
        hits = hits + 1;
      }
    }
  }
  return hits;
}

fn earthHash21(p: vec2<f32>) -> f32 {
  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453123);
}

fn earthValueNoise(p: vec2<f32>) -> f32 {
  let i = floor(p);
  let f = fract(p);
  let w = f * f * (3.0 - 2.0 * f);
  let a = earthHash21(i);
  let b = earthHash21(i + vec2<f32>(1.0, 0.0));
  let c = earthHash21(i + vec2<f32>(0.0, 1.0));
  let d = earthHash21(i + vec2<f32>(1.0, 1.0));
  return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);
}

fn earthFbm(p0: vec2<f32>) -> f32 {
  var p = p0;
  var v = 0.0;
  var amp = 0.5;
  for (var i = 0; i < 5; i = i + 1) {
    v = v + amp * earthValueNoise(p);
    p = p * 2.02;
    amp = amp * 0.5;
  }
  return v;
}

struct EarthHit {
  hit:   bool,
  rr:    f32,
  disk:  vec2<f32>,
  viewN: vec3<f32>,
  lat:   f32,
  lon:   f32,
};

fn earthProject(pos: vec2<f32>, size: vec2<f32>, angle: f32, tilt: f32, radiusFrac: f32, offsetY: f32) -> EarthHit {
  var h: EarthHit;
  // offsetY slides the globe vertically: +1 drops its centre to the bottom
  // edge, -1 lifts it to the top, 0 = centred.
  let center = vec2<f32>(0.5 * size.x, 0.5 * size.y + offsetY * 0.5 * size.y);
  let R = radiusFrac * min(size.x, size.y);
  let p = (pos - center) / R;
  let rr = dot(p, p);
  h.disk = p;
  h.rr = rr;
  h.hit = rr <= 1.0;
  if (!h.hit) {
    h.viewN = vec3<f32>(p.x, -p.y, 0.0);
    h.lat = 0.0;
    h.lon = 0.0;
    return h;
  }
  let V = vec3<f32>(p.x, -p.y, sqrt(max(0.0, 1.0 - rr)));
  h.viewN = V;
  let ct = cos(tilt);
  let st = sin(tilt);
  let T = vec3<f32>(V.x, ct * V.y + st * V.z, -st * V.y + ct * V.z);
  let ca = cos(angle);
  let sa = sin(angle);
  let M = vec3<f32>(ca * T.x - sa * T.z, T.y, sa * T.x + ca * T.z);
  h.lat = asin(clamp(M.y, -1.0, 1.0));
  h.lon = atan2(M.x, M.z);
  return h;
}

fn radarBehind(pixAng: f32, sweepAng: f32) -> f32 {
  var d = sweepAng - pixAng;
  d = d - TWO_PI * floor(d / TWO_PI);
  return d;
}

