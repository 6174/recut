// single 0..1 luminance value; contourThermal maps it onto the low→high colour
// gradient so the style is colourable while keeping the same elevation banding.
fn contourTone(t0: f32) -> f32 {
  let t = clamp(t0, 0.0, 1.0);
  let x = t * 6.0;
  let s0 = 0.07; let s1 = 0.21; let s2 = 0.38;
  let s3 = 0.55; let s4 = 0.72; let s5 = 0.88; let s6 = 1.0;
  if (x < 1.0) { return mix(s0, s1, smoothstep(0.0, 1.0, x)); }
  if (x < 2.0) { return mix(s1, s2, smoothstep(0.0, 1.0, x - 1.0)); }
  if (x < 3.0) { return mix(s2, s3, smoothstep(0.0, 1.0, x - 2.0)); }
  if (x < 4.0) { return mix(s3, s4, smoothstep(0.0, 1.0, x - 3.0)); }
  if (x < 5.0) { return mix(s4, s5, smoothstep(0.0, 1.0, x - 4.0)); }
  return mix(s5, s6, smoothstep(0.0, 1.0, x - 5.0));
}

fn contourThermal(t0: f32, lo: vec3<f32>, hi: vec3<f32>) -> vec3<f32> {
  return mix(lo, hi, contourTone(t0));
}

fn contourField(lat: f32, lon: f32, drift: f32) -> f32 {
  let q = vec2<f32>(lon * (1.0 / PI), lat * (2.0 / PI));
  let base = q * 2.7 + vec2<f32>(11.3, 4.7);
  var f = earthFbm(base + vec2<f32>(drift, -0.5 * drift));
  f = f + 0.45 * earthFbm(base * 2.13 + vec2<f32>(-drift * 1.7, 23.0));
  f = f / 1.45;
  return clamp(f, 0.0, 1.0);
}

fn knee(c: vec3<f32>, k: f32) -> vec3<f32> {
  let over = max(c - vec3<f32>(k), vec3<f32>(0.0));
  return min(c, vec3<f32>(k)) + (1.0 - k) * (vec3<f32>(1.0) - exp(-over / (1.0 - k)));
}

fn spinningEarthAnim(uv01: vec2<f32>) -> vec4<f32> {
  let size = u.size;
  let pos = uv01 * size;
  let angle = u.time * u.speed;
  let e = earthProject(pos, size, angle, u.tilt, u.globeSize, u.offsetY);
  let p = e.disk;
  let rr = e.rr;
  let rad = sqrt(max(rr, 0.0));

  // --- shared dotted graticule (straight-line: derivative calls are legal) ---
  let bands = max(1.0, round(u.detail));
  let dLat = PI / bands;
  let lat = e.lat;
  let lon = e.lon;
  let latNode = round(lat / dLat) * dLat;
  let ring = max(1.0, round(TWO_PI * cos(latNode) / dLat));
  let dLon = TWO_PI / ring;
  let lonNode = round(lon / dLon) * dLon;
  var dLonOff = lon - lonNode;
  dLonOff = dLonOff - TWO_PI * round(dLonOff / TWO_PI);
  let na = (lat - latNode) / dLat;
  let nb = dLonOff / dLon;
  // Round dot (dotRound == 2): length(na, nb) — equal to the MSL pow() form,
  // far cheaper than three pow() calls per pixel.
  let dist = sqrt(na * na + nb * nb);
  let aaw = max(fwidth(dist) * 1.1, 0.012);
  let dotCore = 1.0 - smoothstep(u.dotSize - aaw, u.dotSize + aaw, dist);
  let poleFade = smoothstep(HALF_PI, HALF_PI - 2.0 * dLat, abs(latNode));
  let dotBase = dotCore * poleFade;

  let s = i32(u.style + 0.5);
  var outc = vec3<f32>(0.0);

  if (s == 0) {
    // ---------------------------- Metal Dots ----------------------------
    let dotMask = dotBase * smoothstep(1.0, 0.92, rr);
    let kLight = normalize(vec3<f32>(-0.45, 0.55, 0.70));
    let kLand = u.landColor.rgb;
    let kOcean = u.oceanColor.rgb;
    let kRim = u.atmosphere.rgb;
    if (e.hit) {
      let V = e.viewN;
      let land = earthLandHits(latNode, lonNode, dLat, dLon) >= 4;
      let Hh = normalize(kLight + vec3<f32>(0.0, 0.0, 1.0));
      let diff = max(dot(V, kLight), 0.0);
      let spec = pow(max(dot(V, Hh), 0.0), 34.0);
      let rim = pow(1.0 - V.z, 3.0);
      let base = select(kOcean, kLand, land);
      let lvl = select(0.42, 1.0, land);
      let specLvl = select(0.5, 1.0, land);
      // On water, tint the specular toward the ocean colour (instead of pure
      // white) so changing Ocean visibly shifts the globe; land keeps a white
      // chrome highlight.
      let specTint = select(mix(vec3<f32>(1.0), base, 0.6), vec3<f32>(1.0), land);
      let lit = base * (0.18 + 0.92 * diff) * lvl
              + specTint * (spec * 1.25 * specLvl)
              + kRim * (rim * 0.55) * lvl;
      outc = lit * dotMask;
      let edge = smoothstep(0.92, 1.0, rr) * smoothstep(1.02, 1.0, rr);
      outc = outc + kRim * (edge * 0.16 * (0.4 + 0.6 * diff));
    } else if (rr < 1.18 * 1.18) {
      let d = sqrt(rr) - 1.0;
      let halo = exp(-d * 11.0) * 0.16;
      let diff = max(dot(normalize(vec3<f32>(p.x, -p.y, 0.35)), kLight), 0.0);
      outc = kRim * (halo * (0.35 + 0.65 * diff));
    }
    outc = knee(outc, 0.75);
  } else if (s == 1) {
    // ---------------------------- Radar Ping ----------------------------
    let green = u.sweepColor.rgb;
    let greenHi = mix(green, vec3<f32>(1.0), 0.45);
    let gridG = u.gridColor.rgb;
    var sweep = u.time * u.sweepSpeed;
    sweep = sweep - TWO_PI * floor(sweep / TWO_PI);
    var intensity = 0.0;
    var tint = green;
    if (e.hit) {
      let dotMask = dotBase * smoothstep(1.0, 0.94, rr);
      let hits = earthLandHits(latNode, lonNode, dLat, dLon);  // sample once
      let land = hits >= 4;
      let cover = f32(hits) / 9.0;
      let cellAng = atan2(p.y, p.x);
      let bh = radarBehind(cellAng, sweep);
      let decay = select(2.7, 1.05, land);
      let trail = exp(-bh * decay);
      let lip = smoothstep(0.22, 0.0, bh);
      let baseGlow = select(0.085, 0.16, land);
      let landBoost = select(0.30, 0.85 + 0.6 * cover, land);
      let ping = (trail * 0.9 + lip * 1.4) * landBoost;
      intensity = (baseGlow + ping) * dotMask;
      if (land) {
        let blipKey = earthHash21(vec2<f32>(latNode * 7.3 + 11.0, lonNode * 5.1 + 3.0));
        let isTarget = step(0.82, blipKey);
        var flash = exp(-bh * 1.6) * (0.6 + 0.4 * sin(u.time * 9.0 + blipKey * 30.0));
        flash = max(flash, 0.0);
        intensity = intensity + isTarget * flash * 1.6 * dotMask;
        tint = mix(tint, greenHi, isTarget * lip);
      }
      tint = mix(tint, greenHi, clamp(intensity * 0.7, 0.0, 1.0));
    }
    // scope overlay (masks gate it, so no per-pixel branch is needed)
    let scopeR = 1.06;
    let scopeMask = smoothstep(scopeR, scopeR - 0.02, rad);
    let ringPhase = rad * 4.0;
    let rline = abs(fract(ringPhase + 0.5) - 0.5) * 2.0;
    let rw = max(fwidth(ringPhase) * 1.4, 0.02);
    var grid = smoothstep(rw, 0.0, rline) * 0.5;
    grid = grid + smoothstep(0.012, 0.0, abs(rad - (scopeR - 0.01))) * 0.8;
    let cw = max(fwidth(p.x), fwidth(p.y)) * 1.2 + 0.004;
    var cross = smoothstep(cw, 0.0, abs(p.x)) + smoothstep(cw, 0.0, abs(p.y));
    cross = cross + 0.5 * smoothstep(cw, 0.0, abs(p.x - p.y));
    cross = cross + 0.5 * smoothstep(cw, 0.0, abs(p.x + p.y));
    grid = grid + clamp(cross, 0.0, 1.0) * 0.32;
    grid = grid * scopeMask;
    let pixAng = atan2(p.y, p.x);
    let bh2 = radarBehind(pixAng, sweep);
    let armLine = smoothstep(0.05, 0.0, bh2);
    let armWedge = exp(-bh2 * 2.2) * 0.5;
    let armGlow = (armLine * 0.9 + armWedge) * scopeMask * smoothstep(0.0, 0.12, rad);
    var col = tint * intensity;
    col = col + gridG * grid;
    col = col + green * armGlow * 0.7;
    let lum = dot(col, vec3<f32>(0.3, 0.6, 0.1));
    col = col + green * (lum * lum * 0.6);
    col = col * (0.92 + 0.08 * sin(pos.y * 2.2));
    col = col * (1.0 - smoothstep(0.55, 1.15, rad) * 0.55);
    col = col + green * 0.015 * scopeMask;
    outc = max(col, vec3<f32>(0.004, 0.012, 0.006) * smoothstep(1.6, 0.0, rad));
  } else {
    // ---------------------------- Contour Mono ----------------------------
    let cLo = u.contourLow.rgb;
    let cHi = u.contourHigh.rgb;
    let dotMask = dotBase * smoothstep(1.0, 0.93, rr);
    let drift = u.time * 0.045;
    let cover = f32(earthLandHits(latNode, lonNode, dLat, dLon)) / 9.0;
    var heat = contourField(latNode, lonNode, drift);
    heat = heat + 0.46 * cover - 0.30 * (1.0 - cover);
    heat = heat + 0.08 * cos(latNode);
    heat = clamp(heat, 0.0, 1.0);
    let bandPos = heat * u.contourBands;
    let lineAA = max(fwidth(bandPos), 0.04);
    if (e.hit) {
      let N = normalize(e.viewN);
      var col = contourThermal(heat, cLo, cHi);
      let tri = abs(fract(bandPos) - 0.5) * 2.0;
      let onLine = 1.0 - smoothstep(0.0, lineAA * 4.0, tri);
      let lineTint = mix(col, cHi, 0.45);
      col = mix(col, lineTint, onLine * 0.55);
      let L = normalize(vec3<f32>(-0.35, 0.45, 0.82));
      let diff = 0.55 + 0.45 * max(dot(N, L), 0.0);
      col = col * diff;
      let hot = smoothstep(0.72, 1.0, heat);
      col = col + contourThermal(heat, cLo, cHi) * (hot * 0.85);
      outc = col * dotMask;
      let edge = smoothstep(0.93, 1.0, rr) * smoothstep(1.015, 1.0, rr);
      outc = outc + mix(cLo, cHi, 0.15) * (edge * 0.25);
    } else if (rr < 1.26 * 1.26) {
      let d = sqrt(rr) - 1.0;
      let halo = exp(-d * 9.0) * 0.16;
      outc = mix(cLo, cHi, 0.06) * halo;
    }
    outc = knee(outc, 0.80);
  }

  return vec4<f32>(clamp(outc, vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);
}
