{
  "runtimes": [
    {
      "id": "comfyui",
      "label": {
        "zh": "ComfyUI（共享运行时）",
        "en": "ComfyUI (shared runtime)"
      },
      "venv": "comfyui",
      "runner": "python/comfyui_runner.py",
      "requirements": "python/comfyui.requirements.lock",
      "repository": "https://github.com/comfyanonymous/ComfyUI",
      "revision": "b5cc8830279eae909a59de030af1e50761c36751"
    }
  ],
  "apps": [
    {
      "id": "depth-anything-3",
      "label": {
        "zh": "深度图（Depth Anything 3）",
        "en": "Depth Map (Depth Anything 3)"
      },
      "capability": "image.depth",
      "runtime": "comfyui",
      "exposeModel": "",
      "output": {
        "kind": "image",
        "mimeType": "image/png",
        "ext": "png"
      },
      "inputModes": [
        "image"
      ],
      "formSchema": [
        {
          "key": "references",
          "type": "media",
          "kind": "image",
          "multiple": false,
          "label": {
            "zh": "输入图",
            "en": "Image"
          }
        },
        {
          "key": "render",
          "type": "select",
          "options": [
            "depth",
            "depth_colored"
          ],
          "default": "depth_colored",
          "label": {
            "zh": "输出",
            "en": "Output"
          }
        },
        {
          "key": "normalization",
          "type": "select",
          "options": [
            "v2_style",
            "min_max",
            "raw"
          ],
          "default": "v2_style",
          "label": {
            "zh": "归一化",
            "en": "Normalization"
          }
        },
        {
          "key": "resolution",
          "type": "number",
          "default": 504,
          "min": 140,
          "max": 2520,
          "label": {
            "zh": "分辨率",
            "en": "Resolution"
          }
        }
      ],
      "defaultParams": {
        "render": "depth_colored",
        "normalization": "v2_style",
        "resolution": 504
      },
      "weights": {
        "huggingFace": "Comfy-Org/Depth-Anything-3",
        "modelScope": "",
        "revision": "main",
        "sizeGb": 1.4,
        "files": [
          {
            "role": "model",
            "path": "geometry_estimation/depth_anything_3_mono_large.safetensors"
          }
        ]
      }
    },
    {
      "id": "qwen-image-2.1",
      "label": {
        "zh": "Qwen-Image-2.1 文生图/编辑",
        "en": "Qwen-Image-2.1 t2i/edit"
      },
      "capability": "image.generate",
      "runtime": "comfyui",
      "exposeModel": "qwen-image",
      "output": {
        "kind": "image",
        "mimeType": "image/png",
        "ext": "png"
      },
      "inputModes": [
        "text",
        "image"
      ],
      "formSchema": [
        {
          "key": "prompt",
          "type": "textarea",
          "required": true,
          "label": {
            "zh": "提示词",
            "en": "Prompt"
          }
        },
        {
          "key": "negativePrompt",
          "type": "textarea",
          "label": {
            "zh": "负向词",
            "en": "Negative prompt"
          }
        },
        {
          "key": "references",
          "type": "media",
          "kind": "image",
          "multiple": true,
          "label": {
            "zh": "参考图",
            "en": "References"
          }
        },
        {
          "key": "aspectRatio",
          "type": "select",
          "options": [
            "1:1",
            "16:9",
            "9:16",
            "4:3",
            "3:4"
          ],
          "default": "1:1",
          "label": {
            "zh": "画幅",
            "en": "Aspect ratio"
          }
        },
        {
          "key": "steps",
          "type": "number",
          "default": 10,
          "min": 1,
          "max": 100,
          "label": {
            "zh": "步数",
            "en": "Steps"
          }
        },
        {
          "key": "cfg",
          "type": "number",
          "default": 1.0,
          "min": 0,
          "max": 20,
          "label": {
            "zh": "CFG",
            "en": "CFG"
          }
        },
        {
          "key": "seed",
          "type": "number",
          "default": -1,
          "label": {
            "zh": "随机种子（-1 随机）",
            "en": "Seed (-1 random)"
          }
        }
      ],
      "defaultParams": {
        "aspectRatio": "1:1",
        "steps": 10,
        "cfg": 1.0,
        "negativePrompt": " "
      },
      "weights": {
        "huggingFace": "Comfy-Org/Qwen-Image-2.1",
        "modelScope": "Comfy-Org/Qwen-Image-2.1",
        "revision": "main",
        "sizeGb": 17,
        "files": [
          {
            "role": "unet",
            "path": "diffusion_models/qwen_image_2.1_int8_convrot.safetensors"
          },
          {
            "role": "clip",
            "path": "text_encoders/qwen3vl_8b_int8_convrot.safetensors"
          },
          {
            "role": "vae",
            "path": "vae/qwen_image_2.1_vae_bf16.safetensors"
          }
        ]
      }
    }
  ]
}
