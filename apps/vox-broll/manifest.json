{
  "manifestVersion": 1,
  "id": "recut.vox-broll",
  "name": "Vox B-roll Explainer",
  "version": "0.2.0",
  "type": "project",
  "background": "background.js",
  "ui": { "projectView": "ui/dist/index.html" },
  "permissions": ["sqlite", "files", "artifacts.publish"],
  "apis": [
    {
      "name": "brief.create",
      "description": "创建并保存一份 Vox 视频创作方向。",
      "kind": "command",
      "inputSchema": { "type": "object", "required": ["topic"] }
    },
    {
      "name": "brief.latest",
      "description": "读取当前项目最新的创作方向。",
      "kind": "query",
      "inputSchema": { "type": "object" }
    }
  ],
  "mcp": {
    "tools": [
      {
        "name": "generate_brief",
        "description": "根据主题创建 B-roll 解说视频的创作方向，并返回可消费的 Artifact。",
        "inputSchema": { "type": "object", "required": ["topic"], "properties": { "topic": { "type": "string" } } }
      }
    ]
  }
}
