{
  "name": "@recut/workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true node server.cjs --dev",
    "build": "next build",
    "build:cloudflare": "RECUT_STATIC_EXPORT=1 next build",
    "start": "node server.cjs",
    "lint": "next lint",
    "test": "tsx --tsconfig tsconfig.json --test \"lib/rich-composer/**/*.test.ts\" \"lib/context-catalog/**/*.test.ts\" \"lib/media/**/*.test.ts\" \"lib/world-entity/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:worker": "node scripts/worker-e2e.mjs",
    "wasm:build:vello": "cd lib/pomelo/pomelo-vello-wasm && wasm-pack build --target web --dev && mkdir -p ../../../public/vello-wasm && cp pkg/pomelo_vello_wasm.js pkg/pomelo_vello_wasm_bg.wasm assets/space-grotesk.ttf assets/noto-cjk-subset.otf ../../../public/vello-wasm/"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-virtual": "^3.14.12",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lucide-react": "0.468.0",
    "next": "16.0.10",
    "pixi.js": "^7.4.2",
    "posthog-js": "^1.417.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.3.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.3.8",
    "wavesurfer.js": "7.12.11",
    "yjs": "^13.6.32",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250408.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "^0.185.4",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "wrangler": "^3.114.9"
  }
}
