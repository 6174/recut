fn crWord(idx: i32) -> u32 {
  let c = idx / IMG_CHUNK;
  let w = idx - c * IMG_CHUNK;
  if (c == 0) { return IMG0[w]; }
  if (c == 1) { return IMG1[w]; }
  if (c == 2) { return IMG2[w]; }
  if (c == 3) { return IMG3[w]; }
  if (c == 4) { return IMG4[w]; }
  if (c == 5) { return IMG5[w]; }
  if (c == 6) { return IMG6[w]; }
  if (c == 7) { return IMG7[w]; }
  if (c == 8) { return IMG8[w]; }
  if (c == 9) { return IMG9[w]; }
  if (c == 10) { return IMG10[w]; }
  if (c == 11) { return IMG11[w]; }
  if (c == 12) { return IMG12[w]; }
  if (c == 13) { return IMG13[w]; }
  if (c == 14) { return IMG14[w]; }
  return 0u;
}

fn crTexel(ix: i32, iy: i32) -> vec3<f32> {
  let cx = clamp(ix, 0, IMG_W - 1);
  let cy = clamp(iy, 0, IMG_H - 1);
  let packed = crWord(cy * IMG_W + cx);
  let r = f32((packed >> 16u) & 255u);
  let g = f32((packed >> 8u) & 255u);
  let b = f32(packed & 255u);
  return vec3<f32>(r, g, b) * (1.0 / 255.0);
}

// Bilinear sample of the baked image, uv in [0,1] image space.
fn crSampleImage(uv: vec2<f32>) -> vec3<f32> {
  let x = uv.x * f32(IMG_W) - 0.5;
  let y = uv.y * f32(IMG_H) - 0.5;
  let x0 = i32(floor(x));
  let y0 = i32(floor(y));
  let fx = x - floor(x);
  let fy = y - floor(y);
  let c00 = crTexel(x0,     y0);
  let c10 = crTexel(x0 + 1, y0);
  let c01 = crTexel(x0,     y0 + 1);
  let c11 = crTexel(x0 + 1, y0 + 1);
  return mix(mix(c00, c10, fx), mix(c01, c11, fx), fy);
}

// Aspect-fill (cover) map from canvas uv [0,1] to image uv, cropping the
// overflowing axis — matches the SwiftUI .scaledToFill() framing.
fn crCoverUV(uv01: vec2<f32>) -> vec2<f32> {
  let canvasAspect = u.size.x / u.size.y;
  let imgAspect = f32(IMG_W) / f32(IMG_H);
  var uv = uv01;
  if (canvasAspect > imgAspect) {
    let s = imgAspect / canvasAspect;
    uv.y = (uv01.y - 0.5) * s + 0.5;
  } else {
    let s = canvasAspect / imgAspect;
    uv.x = (uv01.x - 0.5) * s + 0.5;
  }
  return uv;
}

fn concentricRingsAnim(uv01: vec2<f32>) -> vec4<f32> {
  // Virtual point space: fixed height REF_H, width follows the canvas aspect,
  // so the ripple looks identical to a phone-sized view at any canvas size.
  let aspect = u.size.x / u.size.y;
  let vsize = vec2<f32>(REF_H * aspect, REF_H);
  let pos = uv01 * vsize;
  let origin = vec2<f32>(u.originX, u.originY) * vsize;

  let toOrigin = pos - origin;
  let dist = length(toOrigin);
  var dir = vec2<f32>(0.0);
  if (dist > 0.0001) { dir = toOrigin / dist; }

  // One emission == exactly one ring (single-lobe wavelet, peak normalised to 1).
  let halfWidth = max(u.wavelength * 0.5, 1.0);
  let gap = max(u.delay, 0.0001);
  let age0 = u.time - gap * floor(u.time / gap);

  var waveSum = 0.0;
  var crestSum = 0.0;
  for (var i = 0; i < RING_COUNT; i = i + 1) {
    let age = age0 + f32(i) * gap;
    let radius = age * u.speed;
    let x = (dist - radius) / halfWidth;
    let g = exp(-0.5 * x * x);
    waveSum = waveSum + 1.64872 * x * g;
    crestSum = crestSum + g;
  }

  let distFalloff = exp(-dist * u.decay);
  let disp = u.amplitude * waveSum * distFalloff;

  // Chromatic dispersion: sample R/G/B at slightly different ripple offsets for
  // a watery prism edge on the rings (dispersion == 0 => all three coincide).
  let dr = disp * (1.0 + u.dispersion);
  let db = disp * (1.0 - u.dispersion);
  let r = crSampleImage(crCoverUV((pos + dir * dr)   / vsize)).r;
  let g = crSampleImage(crCoverUV((pos + dir * disp) / vsize)).g;
  let b = crSampleImage(crCoverUV((pos + dir * db)   / vsize)).b;
  var col = vec3<f32>(r, g, b);

  // Wet sheen along each ring crest, tinted by sheenColor.
  let highlight = u.sheenColor.rgb * (crestSum * distFalloff * u.shine);
  col = clamp(col + highlight, vec3<f32>(0.0), vec3<f32>(1.0));
  return vec4<f32>(col, 1.0);
}
