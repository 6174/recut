static bool earthLandPoint(float lat, float lon) {
    float u = fract((lon + M_PI_F) / (2.0 * M_PI_F));
    float v = clamp((M_PI_2_F - lat) / M_PI_F, 0.0, 0.99999);
    int col = clamp(int(u * float(EARTH_W)), 0, EARTH_W - 1);
    int row = clamp(int(v * float(EARTH_H)), 0, EARTH_H - 1);
    uint word = EARTH_MASK[row * EARTH_WORDS_PER_ROW + (col >> 5)];
    return ((word >> uint(col & 31)) & 1u) != 0u;
}

static int earthLandHits(float lat, float lon, float dLat, float dLon) {
    int hits = 0;
    for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++)
            hits += earthLandPoint(lat + float(j) * dLat * 0.4,
                                   lon + float(i) * dLon * 0.4) ? 1 : 0;
    return hits;
}

static float earthHash21(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453123);
}

static float earthValueNoise(float2 p) {
    float2 i = floor(p), f = fract(p);
    float2 w = f * f * (3.0 - 2.0 * f);
    float a = earthHash21(i);
    float b = earthHash21(i + float2(1.0, 0.0));
    float c = earthHash21(i + float2(0.0, 1.0));
    float d = earthHash21(i + float2(1.0, 1.0));
    return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);
}

static float earthFbm(float2 p) {
    float v = 0.0, amp = 0.5;
    for (int i = 0; i < 5; i++) { v += amp * earthValueNoise(p); p *= 2.02; amp *= 0.5; }
    return v;
}

struct EarthHit { bool hit; float rr; float2 disk; float3 viewN; float lat; float lon; };

static EarthHit earthProject(float2 position, float2 size, float angle, float tilt, float radiusFrac, float offsetY) {
    EarthHit h;
    float2 center = float2(0.5 * size.x, 0.5 * size.y + offsetY * 0.5 * size.y);
    float  R = radiusFrac * min(size.x, size.y);
    float2 p = (position - center) / R;
    float  rr = dot(p, p);
    h.disk = p; h.rr = rr; h.hit = (rr <= 1.0);
    if (!h.hit) { h.viewN = float3(p.x, -p.y, 0.0); h.lat = 0.0; h.lon = 0.0; return h; }
    float3 V = float3(p.x, -p.y, sqrt(max(0.0, 1.0 - rr)));
    h.viewN = V;
    float ct = cos(tilt), st = sin(tilt);
    float3 T = float3(V.x, ct * V.y + st * V.z, -st * V.y + ct * V.z);
    float ca = cos(angle), sa = sin(angle);
    float3 M = float3(ca * T.x - sa * T.z, T.y, sa * T.x + ca * T.z);
    h.lat = asin(clamp(M.y, -1.0, 1.0));
    h.lon = atan2(M.x, M.z);
    return h;
}

static float3 mfKnee(float3 c, float k) {
    float3 over = max(c - k, 0.0);
    return min(c, k) + (1.0 - k) * (1.0 - exp(-over / (1.0 - k)));
}
static half4 seDots(EarthHit e, float detail, float dotSize,
                    half4 landColor, half4 oceanColor, half4 atmosphere) {
    float2 p = e.disk; float rr = e.rr;
    float3 kLight = normalize(float3(-0.45, 0.55, 0.70));
    float3 kLand = float3(landColor.rgb), kOcean = float3(oceanColor.rgb), kRim = float3(atmosphere.rgb);
    float3 outc = float3(0.0);
    if (e.hit) {
        float3 V = e.viewN; float lat = e.lat, lon = e.lon;
        float dLat = M_PI_F / max(1.0, round(detail));
        float latNode = round(lat / dLat) * dLat;
        float ring = max(1.0, round(2.0 * M_PI_F * cos(latNode) / dLat));
        float dLon = 2.0 * M_PI_F / ring;
        float lonNode = round(lon / dLon) * dLon;
        bool land = earthLandHits(latNode, lonNode, dLat, dLon) >= 4;
        float dLonOff = lon - lonNode; dLonOff -= 2.0 * M_PI_F * round(dLonOff / (2.0 * M_PI_F));
        float a = (lat - latNode) / dLat, b = dLonOff / dLon;
        float dist = pow(pow(abs(a), 2.0) + pow(abs(b), 2.0), 0.5);
        float aa = max(fwidth(dist) * 1.1, 0.012);
        float dotMask = 1.0 - smoothstep(dotSize - aa, dotSize + aa, dist);
        float poleFade = smoothstep(M_PI_2_F, M_PI_2_F - 2.0 * dLat, abs(latNode));
        dotMask *= poleFade * smoothstep(1.0, 0.92, rr);
        float3 Hh = normalize(kLight + float3(0.0, 0.0, 1.0));
        float diff = max(dot(V, kLight), 0.0);
        float spec = pow(max(dot(V, Hh), 0.0), 34.0);
        float rim = pow(1.0 - V.z, 3.0);
        float3 base = land ? kLand : kOcean;
        float lvl = land ? 1.0 : 0.42, specLvl = land ? 1.0 : 0.5;
        float3 specTint = land ? float3(1.0) : mix(float3(1.0), base, 0.6);
        float3 lit = base * (0.18 + 0.92 * diff) * lvl + specTint * (spec * 1.25 * specLvl) + kRim * (rim * 0.55) * lvl;
        outc = lit * dotMask;
        float edge = smoothstep(0.92, 1.0, rr) * smoothstep(1.02, 1.0, rr);
        outc += kRim * (edge * 0.16 * (0.4 + 0.6 * diff));
    } else if (rr < 1.18 * 1.18) {
        float d = sqrt(rr) - 1.0;
        float halo = exp(-d * 11.0) * 0.16;
        float diff = max(dot(normalize(float3(p.x, -p.y, 0.35)), kLight), 0.0);
        outc = kRim * (halo * (0.35 + 0.65 * diff));
    }
    return half4(half3(clamp(mfKnee(outc, 0.75), 0.0, 1.0)), 1.0);
}

[[ stitchable ]] half4 spinningEarthDots(float2 position, half4 color,
                                         float4 boundingRect, float time,
                                         float speed, float tilt, float globeSize,
                                         float detail, float dotSize, float offsetY,
                                         half4 landColor, half4 oceanColor, half4 atmosphere) {
    float2 size = boundingRect.zw;
    EarthHit e = earthProject(position, size, time * speed, tilt, globeSize, offsetY);
    return seDots(e, detail, dotSize, landColor, oceanColor, atmosphere);
}
