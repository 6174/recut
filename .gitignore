# Local Go and Next.js build artifacts.
node_modules
.next
.cache
coverage.out
.DS_Store
build/
web/out/
web/public/releases/
# vello 世界画布：wasm 产物与拷贝字体由 pnpm wasm:build:vello 生成（可重建）；
# 完整中文字体 noto-sans-sc.otf 入库（~16MB），避免开发者因缺字体大量丢字。
web/public/vello-wasm/pomelo_vello_wasm.js
web/public/vello-wasm/pomelo_vello_wasm_bg.wasm
web/public/vello-wasm/space-grotesk.ttf
web/public/vello-wasm/noto-cjk-subset.otf
service/ui/assets/*
# 构建产物：Go service 二进制（make service-build 输出到 build/，此处兜底本地 `go build` 直出）。
service/recut-service
# Release-generated built-in App archives stay local to each build.
service/builtin_apps/*.tar.gz
!service/ui/assets/.keep
.wrangler
# CDN 资源本地暂存区可再生成（源头为 fetch 脚本 + R2），不提交二进制。
cdn/buckets/*
!cdn/buckets/.gitkeep
# R2 S3 本地凭据（deploy 用），不提交 git。
cdn/.r2-credentials
cdn/.env
output/
.executor-tasks/
